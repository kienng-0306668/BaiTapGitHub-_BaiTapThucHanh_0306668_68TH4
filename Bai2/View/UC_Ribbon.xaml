<UserControl x:Class="DoAnLapTrinhXayDung.View.UC_Ribbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DoAnLapTrinhXayDung.View"
             xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        
        <Ribbon Background="#CCFFFF">
            <RibbonTab Header="Dữ Liệu">
                <RibbonGroup Header="Tệp">
                    <RibbonButton Label="Mở" Click="btnOpen_Click" LargeImageSource="/Icons/Folder.ico" />
                    <RibbonButton Label="Lưu" Click="btnSave_Click" LargeImageSource="/Icons/Save.ico" />
                </RibbonGroup>

                <RibbonGroup Header="Kết nối">
                    <RibbonButton Label ="Etabs API " Click="btnEtabs_Click" LargeImageSource="/Icons/Link.ico" />
                </RibbonGroup>

                <RibbonGroup Header="Số liệu đầu vào">
                    <RibbonButton Label="Vật liệu" Click="btnVatLieu_Click" LargeImageSource="/Icons/Steel I Beam.ico"/>
                    <RibbonButton Label="Thông số" Click="btnThongSo_Click" LargeImageSource="/Icons/List.ico" />
                </RibbonGroup>
            </RibbonTab>

            <RibbonTab Header="Hiển Thị">
                <RibbonGroup Header="Góc Nhìn">
                    <RibbonButton Label="Mặt Bằng " Click="btnMatBang_Click" LargeImageSource="/Icons/Blueprint.ico" />
                    <RibbonButton Label="Hiển thị 3D" Click="btn3D_Click" LargeImageSource="/Icons/3D.ico" />
                </RibbonGroup>

                <RibbonGroup Header="Thao Tác">
                    <RibbonButton Label="Zoom In" Click="btnZoomIn_Click" LargeImageSource="/Icons/Zoom In.ico" />
                    <RibbonButton Label="Zoom Out" Click="btnZoomOut_Click" LargeImageSource="/Icons/Zoom Out.ico" />
                </RibbonGroup>


            </RibbonTab>

            <RibbonTab Header="Thiết Kế">
                <RibbonGroup Header="Tính toán">
                    <RibbonButton Label="Chạy Thiết Kế" LargeImageSource="/Icons/Play.ico" />
                </RibbonGroup>
            </RibbonTab>
        
        
            <StatusBar VerticalAlignment="Bottom" Background="Transparent">
                <ProgressBar x:Name="pbLoading" 
              Width="150" Height="15" 
              IsIndeterminate="True" 
              Visibility="Collapsed" 
              Margin="5"/>

                <TextBlock x:Name="txtLoadingStatus" 
            Text="Đang khởi tạo kết nối với phần mềm Etabs..." 
            Visibility="Collapsed" 
            VerticalAlignment="Center"
            Margin="5,0,0,0"/>
            </StatusBar>
        </Ribbon>

    </Grid>
</UserControl>
