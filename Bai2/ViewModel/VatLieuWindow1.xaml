<Window x:Class="DoAnLapTrinhXayDung.view.VatLieuWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khai báo thông số Cột thép chữ I" Height="350" Width="850">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <UniformGrid Columns="4" Grid.Row="0">
            <GroupBox Header="1. Vật liệu" Margin="5">
                <StackPanel>
                    <TextBlock Text="Fy (Mpa):" Margin="0,5"/>
                    <TextBox x:Name="txtFy" Text="235"/>
                    <TextBlock Text="E (Mpa):" Margin="0,5"/>
                    <TextBox x:Name="txtE" Text="210000"/>
                    <TextBlock Text="Yc (Hệ số):" Margin="0,5"/>
                    <TextBox x:Name="txtYc" Text="1.0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. Hình học" Margin="5">
                <StackPanel>
                    <TextBlock Text="Chiều cao h:" Margin="0,2"/>
                    <TextBox x:Name="txtH" Text="300"/>
                    <TextBlock Text="Bề rộng b:" Margin="0,2"/>
                    <TextBox x:Name="txtB" Text="200"/>
                    <TextBlock Text="Chiều dày tf:" Margin="0,2"/>
                    <TextBox x:Name="txtTf" Text="12"/>
                    <TextBlock Text="ix (mm):" Margin="0,2"/>
                    <TextBox x:Name="txtIx" Text="120"/>
                    <TextBlock Text="iy (mm):" Margin="0,2"/>
                    <TextBox x:Name="txtIy" Text="45"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="3. Nội lực" Margin="5">
                <StackPanel>
                    <TextBlock Text="Lực dọc N (kN):" Margin="0,5"/>
                    <TextBox x:Name="txtN" Text="500"/>
                    <TextBlock Text="Moment Mx (kNm):" Margin="0,5"/>
                    <TextBox x:Name="txtMx" Text="100"/>
                    <TextBlock Text="Moment My (kNm):" Margin="0,5"/>
                    <TextBox x:Name="txtMy" Text="20"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="4. Chiều dài" Margin="5">
                <StackPanel>
                    <TextBlock Text="Lox (m):" Margin="0,5"/>
                    <TextBox x:Name="txtLox" Text="4.5"/>
                    <TextBlock Text="Loy (m):" Margin="0,5"/>
                    <TextBox x:Name="txtLoy" Text="4.5"/>
                </StackPanel>
            </GroupBox>
        </UniformGrid>

        <Button Grid.Row="1" Content="Xác nhận" Width="100" HorizontalAlignment="Right" Click="btnXacNhan_Click"/>
    </Grid>
</Window>