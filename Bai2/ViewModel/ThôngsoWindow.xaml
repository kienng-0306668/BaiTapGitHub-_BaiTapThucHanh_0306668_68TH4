<Window x:Class="DoAnLapTrinhXayDung.view.ThongSoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DoAnLapTrinhXayDung.view"
        mc:Ignorable="d"
        Title="ThongSoWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="20">
            <StackPanel>
                <TextBlock Text="Lớp bảo vệ (mm):" Margin="0,5"/>
                <TextBox x:Name="txtLopBaoVe" Text="25"/>

                <TextBlock Text="Hệ số an toàn:" Margin="0,15,0,5"/>
                <TextBox x:Name="txtHeSoAnToan" Text="1.1"/>

                <Button Content="Xác nhận" Click="btnXacNhan_Click" Margin="0,20,0,0" Height="30"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>